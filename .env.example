APP_NAME="ARTA LECA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional CDN origin for build assets, fonts and uploaded media. Leave empty to
# serve everything from the application host. When set, the origin is added to
# the Content-Security-Policy automatically.
ASSET_URL=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset on purpose: it defaults to true whenever APP_ENV=production, so a
# forgotten variable cannot downgrade the session cookie to plain HTTP. Set it
# to false only for a staging box that genuinely has no TLS.
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Site identity ───────────────────────────────────────────────────────────
# Everything below is optional; config/site.php carries sensible defaults.
SITE_LEGAL_NAME="Arta Leca Industrial Co."
SITE_BRAND="ARTA LECA"

SITE_PHONE="+98 21 8888 0000"
SITE_SALES_PHONE="+98 21 8888 0011"
SITE_FAX="+98 21 8888 0099"
SITE_EMAIL=info@artaleca.com
SITE_SALES_EMAIL=sales@artaleca.com
SITE_EXPORT_EMAIL=export@artaleca.com

SITE_LINKEDIN=
SITE_INSTAGRAM=
SITE_TWITTER=
GOOGLE_SITE_VERIFICATION=

# ── Admin bootstrap ─────────────────────────────────────────────────────────
# Used only by UserSeeder. Outside `local`, leaving ADMIN_PASSWORD unset makes
# the seeder generate a random password and print it once — it never creates a
# known-credential account on a reachable server.
ADMIN_EMAIL=admin@artaleca.com
ADMIN_PASSWORD=
