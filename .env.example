APP_NAME="ARTA LECA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional CDN origin for build assets, fonts and uploaded media. Leave empty to
# serve everything from the application host. When set, the origin is added to
# the Content-Security-Policy automatically.
ASSET_URL=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset on purpose: it defaults to true whenever APP_ENV=production, so a
# forgotten variable cannot downgrade the session cookie to plain HTTP. Set it
# to false only for a staging box that genuinely has no TLS.
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes every message into storage/logs/laravel.log and reports success,
# which is right for development and silently wrong on a live server: the sales
# desk is never told about an enquiry. On the server this becomes `smtp` with
# the mailbox's own credentials — the whole procedure, DNS records included, is
# in docs/deploy-ubuntu.md under "The company email". `php artisan mail:test`
# sends one for real and prints what the mail server said.
MAIL_MAILER=log

# The live values look like this. `ssl` on 465 or `tls` on 587, whichever the
# mail host documents; the username is the full address, not the part before
# the @.
# MAIL_MAILER=smtp
# MAIL_HOST=mail.artaleca.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=info@artaleca.com
# MAIL_PASSWORD="the mailbox password"

MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Must be an address at a domain the sending account is allowed to send as, or
# SPF and DKIM fail and the message lands in spam however correct the rest is.
MAIL_FROM_ADDRESS=info@artaleca.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Site identity ───────────────────────────────────────────────────────────
# Everything below is optional; config/site.php carries sensible defaults.
SITE_LEGAL_NAME="Arta Leca Industrial Co."
SITE_BRAND="ARTA LECA"

SITE_PHONE="+98 21 8888 0000"
SITE_SALES_PHONE="+98 21 8888 0011"
SITE_FAX="+98 21 8888 0099"
SITE_EMAIL=info@artaleca.com
SITE_SALES_EMAIL=sales@artaleca.com
SITE_EXPORT_EMAIL=export@artaleca.com

# The messenger desks behind the support button in the corner of every page.
# Better set in Panel → Settings → Support and messengers, which is where
# whoever answers them will change them. Empty means the channel is not
# offered, which is the right default — a link to an account nobody holds
# costs the visitor the one thing they opened it for.
SITE_WHATSAPP=
SITE_TELEGRAM=
SITE_RUBIKA=

SITE_LINKEDIN=
SITE_INSTAGRAM=
SITE_TWITTER=
GOOGLE_SITE_VERIFICATION=

# ── Admin bootstrap ─────────────────────────────────────────────────────────
# Used only by UserSeeder. Outside `local`, leaving ADMIN_PASSWORD unset makes
# the seeder generate a random password and print it once — it never creates a
# known-credential account on a reachable server.
ADMIN_EMAIL=admin@artaleca.com
ADMIN_PASSWORD=

